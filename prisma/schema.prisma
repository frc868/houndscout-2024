//Once you've set up your database:
//*npx prisma migrate dev: updates the layout of your database with this schema.
//*npx prisma studio: starts Prisma Studio, allowing you to view and edit data on your database directly.

//Don't need to mess with the generators.
generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
}

//MAKE SURE YOU DO THE FOLLOWING TO MAKE YOUR DATABASE WORK:
//set your database name to "houndscout"
//set your database user to "techhounds"
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")//Make a .env filed with DATABASE_URL linking to your database.
}

// The tables/collections in a database. Some of these link to each other.

//Currently, this will have to be manually created. Make sure you set the active event to something as well.
model Server {
  id            Int         @id @default(autoincrement())
  activeEvent   Event?      @relation(fields: [activeEventId], references: [id])
  activeEventId Int?        @map("eventId")
  activeMatch   Match?      @relation(fields: [activeMatchId], references: [id])
  activeMatchId Int?
  heartbeats    Heartbeat[]
  blueOnLeft    Boolean
}

//You'll need to manually create six of these, one per team on the field.
model Heartbeat {
  id      Int      @id @default(autoincrement())
  station Station  @unique @default(RED1)
  time    DateTime
  section Section  @default(AUTO)

  server   Server @relation(fields: [serverId], references: [id])
  serverId Int
}

//These can be created through the admin panel.
model Scouter {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  TeamScore TeamScore[]
}

//One will need to be created manually to make the system work, but after that you can create them on the admin panel.
model Event {
  id    Int    @id @default(autoincrement())
  code  String @unique
  teams Team[]

  name       String?
  address    String?
  weekNumber Int?
  startDate  DateTime?
  endDate    DateTime?

  matches Match[]
  servers Server[]
}

//One will need to be created manually to make the system work, but after that you can create them on the admin panel.
model Team {
  id           Int         @id @default(autoincrement())
  number       Int         @unique
  name         String
  location     String
  events       Event[]
  red1Matches  Match[]     @relation("Red1Team")
  red2Matches  Match[]     @relation("Red2Team")
  red3Matches  Match[]     @relation("Red3Team")
  blue1Matches Match[]     @relation("Blue1Team")
  blue2Matches Match[]     @relation("Blue2Team")
  blue3Matches Match[]     @relation("Blue3Team")
  teamScores   TeamScore[]
  //picklist     Boolean     @default(true)
}

//One will need to be created manually to make the system work, but after that you can create them on the admin panel.
model Match {
  id        Int    @id @default(autoincrement())
  key       String @unique
  name      String
  number    Int
  event     Event  @relation(fields: [eventCode], references: [code])
  eventCode String

  startTime DateTime?

  red1TeamId Int
  red2TeamId Int
  red3TeamId Int
  red1Team   Team @relation("Red1Team", fields: [red1TeamId], references: [id])
  red2Team   Team @relation("Red2Team", fields: [red2TeamId], references: [id])
  red3Team   Team @relation("Red3Team", fields: [red3TeamId], references: [id])

  blue1TeamId Int
  blue2TeamId Int
  blue3TeamId Int
  blue1Team   Team @relation("Blue1Team", fields: [blue1TeamId], references: [id])
  blue2Team   Team @relation("Blue2Team", fields: [blue2TeamId], references: [id])
  blue3Team   Team @relation("Blue3Team", fields: [blue3TeamId], references: [id])

  red1TeamScoreId Int       @unique
  red2TeamScoreId Int       @unique
  red3TeamScoreId Int       @unique
  red1TeamScore   TeamScore @relation("Red1TeamScore", fields: [red1TeamScoreId], references: [id])
  red2TeamScore   TeamScore @relation("Red2TeamScore", fields: [red2TeamScoreId], references: [id])
  red3TeamScore   TeamScore @relation("Red3TeamScore", fields: [red3TeamScoreId], references: [id])

  blue1TeamScoreId Int       @unique
  blue2TeamScoreId Int       @unique
  blue3TeamScoreId Int       @unique
  blue1TeamScore   TeamScore @relation("Blue1TeamScore", fields: [blue1TeamScoreId], references: [id])
  blue2TeamScore   TeamScore @relation("Blue2TeamScore", fields: [blue2TeamScoreId], references: [id])
  blue3TeamScore   TeamScore @relation("Blue3TeamScore", fields: [blue3TeamScoreId], references: [id])

  Server Server[]

  @@unique([name, eventCode])
}

//Each of these represents one robot's performance in one match. A lot of these might need to be adjusted.
model TeamScore {
  id     Int  @id @default(autoincrement())
  teamId Int
  team   Team @relation(fields: [teamId], references: [id])

//Prematch
  preloaded             Boolean              @default(true)
  autoStartingZone      AutoStartingZone?

//Auton
  leftStartingZone      Boolean              @default(false)
  // autoGamePieces        AutoGamePiece[] //The pieces the robot attempted to pick up; comment out
  // missingAutoGamePieces AutoGamePiece[] //The pieces the robot attempted but failed to pick up; comment out
  // autoGamePiecesScored  Int                  @default(0) //The overall pieces scored; comment out
  
  autoCoralScoringEvents     AutoCoralScoringEvent[]
  autoAlgaeScoringEvents     AutoAlgaeScoringEvent[]

//Teleop
  teleopCoralScoringEvents   TeleopCoralScoringEvent[]
  teleopAlgaeScoringEvents   TeleopAlgaeScoringEvent[]


  incapSegments         IncapSegment[]

//Endgame
  endgameType             EndgameType?
  endgameSuccess          Boolean?   @default(false)

//Postmatch
  driverSkillRating Int?
  result            Result?
  playedDefense     Boolean?
  comments          String?

  submitted Boolean @default(false)

  scouter   Scouter? @relation(fields: [scouterId], references: [id])
  scouterId Int?

  red1Match        Match?             @relation("Red1TeamScore")
  red2Match        Match?             @relation("Red2TeamScore")
  red3Match        Match?             @relation("Red3TeamScore")
  blue1Match       Match?             @relation("Blue1TeamScore")
  blue2Match       Match?             @relation("Blue2TeamScore")
  blue3Match       Match?             @relation("Blue3TeamScore")
}

//The following four models are based on scoring events. There's one for each combination of phase and game piece.
//Should be roughly the same aside from the different enums used.
model AutoCoralScoringEvent {
  id                Int              @id @default(autoincrement())
  intakeLocation    AutoCoralIntakeLocation
  scoringLevel      CoralScoringLevel?//If the piece was dropped, anything scoring related won't be filled in.
  scoringSide       AutoCoralScoringSide?
  dropped           Boolean          @default(false) //For dropping the piece while not scoring
  failedScoring     Boolean          @default(false) //For trying to score and failing
  timestampPickedUp Decimal //The time the game piece was selected, or the start time if going from preload.
  timestampScored   Decimal //Just do this based on whatever scoring input was clicked first for accuracy purposes.

  teamScoreId Int
  teamScore   TeamScore @relation(fields: [teamScoreId], references: [id])
}
model AutoAlgaeScoringEvent {
  id                Int              @id @default(autoincrement())
  intakeLocation    AutoAlgaeIntakeLocation
  scoringLocation   AlgaeScoringLocation?
  dropped           Boolean          @default(false)
  failedScoring     Boolean          @default(false)
  timestampPickedUp Decimal
  timestampScored   Decimal

  teamScoreId Int
  teamScore   TeamScore @relation(fields: [teamScoreId], references: [id])
}

model TeleopCoralScoringEvent {
  id                Int              @id @default(autoincrement())
  intakeLocation    TeleopCoralIntakeLocation
  scoringLocation   CoralScoringLevel?
  dropped           Boolean          @default(false)
  failedScoring     Boolean          @default(false)
  timestampPickedUp Decimal
  timestampScored   Decimal

  teamScoreId Int
  teamScore   TeamScore @relation(fields: [teamScoreId], references: [id])
}

model TeleopAlgaeScoringEvent {
  id                Int              @id @default(autoincrement())
  intakeLocation    TeleopAlgaeIntakeLocation
  scoringLocation   AlgaeScoringLocation?
  dropped           Boolean          @default(false)
  failedScoring     Boolean          @default(false)
  timestampPickedUp Decimal
  timestampScored   Decimal

  teamScoreId Int
  teamScore   TeamScore @relation(fields: [teamScoreId], references: [id])
}

//Unimplemented, as far as I'm aware. Probably going to put this on the client status bar.
model IncapSegment {
  id               Int       @id @default(autoincrement())
  timestampStarted Decimal
  timestampEnded   Decimal
  full             Boolean
  teamScoreId      Int
  TeamScore        TeamScore @relation(fields: [teamScoreId], references: [id])
}

//These enums are here so we can set the data type for certain columns to them. I think.
// This one should be the same between games, just mapped to different locations.
enum AutoStartingZone {
  ONE
  TWO
  THREE
}

enum AutoCoralIntakeLocation {
  PRELOAD
  GROUND1 //Numbers go from top to bottom
  GROUND2
  GROUND3
}

enum AutoAlgaeIntakeLocation {
  REEF1
  REEF2
  REEF3 //These correspond to the sides in AutoCoralScoringSide below.
  REEF4
  REEF5
  REEF6
  GROUND1
  GROUND2
  GROUND3
}

enum TeleopCoralIntakeLocation {
  GROUND
  STATION
}

enum TeleopAlgaeIntakeLocation {
  GROUND
  REEF
}

enum CoralScoringLevel {
  LEVEL1
  LEVEL2
  LEVEL3
  LEVEL4
}

enum AutoCoralScoringSide {
  SIDE1
  SIDE2
  SIDE3//I think these should go clockwise with 3 and 4 the closest to the starting line, just for consistency.
  SIDE4
  SIDE5
  SIDE6
}

enum AlgaeScoringLocation {
  NET
  PROCESSOR
}

//Needs to be updated.
enum EndgameType {
  NONE
  PARKED
  SHALLOW
  DEEP
}
enum Result {
  WIN
  TIE
  LOSS
}

//Keep the same.
enum Section {
  PREMATCH
  AUTO
  TELEOP
  POSTMATCH
}
enum Station {
  RED1
  RED2
  RED3
  BLUE1
  BLUE2
  BLUE3
}

