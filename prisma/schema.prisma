//Unimplemented. All current functionality is currently in teamScore.
model StageAttempt {
  id Int @id @default(autoincrement())

  teamScoreId Int
  teamScore   TeamScore @relation(fields: [teamScoreId], references: [id])
}

//Unimplemented, as far as I'm aware. Probably going to put this on the client status bar.
model IncapSegment {
  id               Int       @id @default(autoincrement())
  timestampStarted Decimal
  timestampEnded   Decimal
  full             Boolean
  teamScoreId      Int
  TeamScore        TeamScore @relation(fields: [teamScoreId], references: [id])
}

//These enums are here so we can set the data type for certain columns to them. I think.
// This one should be the same between games, just mapped to different locations.
enum AutoStartingZone {
  ONE
  TWO
  THREE
}

//This will probably become FieldGamePiece, or merged with IntakeLocation
//This needs to be updated between games,
enum AutoGamePiece {
  PRELOAD
  CENTER1
  CENTER2
  CENTER3
  CENTER4
  CENTER5
  CLOSE1
  CLOSE2
  CLOSE3
}

//May be merged with IntakeLocation.
//Should probably check for updates between games.
//One per game piece.
enum IntakeLocation {
  GROUND
  SOURCE//probably change to a more generic term.
  //PRELOAD
}

//Needs to be updated.
//One per game piece.
enum ScoringLocation {
  SPEAKER
  AMP
  PASS
}

//Needs to be updated.
//Change to the more generic EndgameType.
enum ClimbType {
  NONE
  PARKED
  CLIMBED
}

//Keep the same.
enum Section {
  PREMATCH
  AUTO
  TELEOP
  POSTMATCH
}

//Keep the same.
enum Station {
  RED1
  RED2
  RED3
  BLUE1
  BLUE2
  BLUE3
}

